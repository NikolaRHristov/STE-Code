{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STE-Code Vocabulary Entry Schema",
  "description": "Validates every entry in data/vocabulary/ files",
  "type": "object",
  "required": ["term", "type", "category-id", "domain", "severity"],
  "properties": {
    "term": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["noun", "verb", "adjective", "adverb", "preposition", "keyword"] },
    "category-id": { "type": ["integer", "null"], "minimum": 1, "maximum": 19 },
    "domain": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "severity": { "type": "string", "enum": ["blocking", "warning", "advisory", "approved"] },
    "note": { "type": "string" },
    "added-by": { "type": "string" },
    "added-date": { "type": "string", "format": "date" }
  }
}

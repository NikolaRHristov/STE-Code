{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STE-Code Rule Frontmatter Schema",
  "description": "Validates the YAML frontmatter of every file in core/rules/",
  "type": "object",
  "required": ["id", "section", "principle", "title", "constraint-type", "scope", "severity", "agentic-load", "domain"],
  "properties": {
    "id": { "type": "string", "pattern": "^rule-\\d+\\.\\d+$|^gr-\\d+$" },
    "section": { "type": "integer", "minimum": 1, "maximum": 9 },
    "principle": { "type": "string", "pattern": "^P\\d{1,2}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "constraint-type": { "type": "string", "enum": ["vocabulary", "grammar", "structure", "safety", "agentic"] },
    "scope": { "type": "array", "items": { "type": "string", "enum": ["noun", "verb", "adjective", "adverb", "sentence", "document", "agent"] }, "minItems": 1 },
    "severity": { "type": "string", "enum": ["blocking", "warning", "advisory", "critical"] },
    "agentic-load": { "type": "string", "enum": ["required", "optional", "conditional"] },
    "domain": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "related-rules": { "type": "array", "items": { "type": "string" } },
    "anti-patterns": { "type": "array", "items": { "type": "string" } },
    "synonym-table": { "type": "boolean" }
  }
}

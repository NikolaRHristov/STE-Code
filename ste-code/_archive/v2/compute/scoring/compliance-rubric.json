{
  "$schema": "../../schemas/scoring.schema.json",
  "version": "1.0.0",
  "description": "Weighted compliance scoring rubric. Each principle has a weight (total = 100). A document's compliance score = sum of passed principle weights.",
  "max-score": 100,
  "pass-threshold": 80,
  "principles": [
    { "id": "P1",  "rule": "rule-1.1",  "name": "Approved Vocabulary",          "weight": 20, "severity": "blocking" },
    { "id": "P2",  "rule": "rule-1.2",  "name": "Term Type Consistency",         "weight": 8,  "severity": "blocking" },
    { "id": "P3",  "rule": "rule-1.3",  "name": "Approved Meaning",              "weight": 8,  "severity": "blocking" },
    { "id": "P4",  "rule": "rule-1.4",  "name": "Approved Forms",                "weight": 5,  "severity": "blocking" },
    { "id": "P5",  "rule": "rule-1.5",  "name": "Noun Category Membership",      "weight": 7,  "severity": "blocking" },
    { "id": "P6",  "rule": "rule-1.6",  "name": "Unapproved Nouns Are Technical","weight": 5,  "severity": "warning" },
    { "id": "P7",  "rule": "rule-1.7",  "name": "No Noun-as-Verb",               "weight": 7,  "severity": "blocking" },
    { "id": "P8",  "rule": "rule-1.8",  "name": "Established Technical Nouns",   "weight": 4,  "severity": "advisory" },
    { "id": "P9",  "rule": "rule-1.9",  "name": "Short Clear Nouns",             "weight": 3,  "severity": "advisory" },
    { "id": "P10", "rule": "rule-1.10", "name": "No Slang or Jargon",            "weight": 5,  "severity": "blocking" },
    { "id": "P11", "rule": "rule-1.11", "name": "One Term Per Concept",          "weight": 10, "severity": "blocking" },
    { "id": "P12", "rule": "rule-1.12", "name": "Verb Category Membership",      "weight": 7,  "severity": "blocking" },
    { "id": "P13", "rule": "rule-1.13", "name": "No Verb-as-Noun",               "weight": 7,  "severity": "blocking" },
    { "id": "P14", "rule": "rule-1.14", "name": "American English Spelling",     "weight": 4,  "severity": "warning" }
  ]
}

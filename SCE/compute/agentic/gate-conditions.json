{
  "version": "1.0.0",
  "description": "STE-Code pipeline gate conditions — each gate must pass before the next stage begins",
  "gates": [
    {
      "id": "GATE-0",
      "name": "Source verification",
      "stage": "pre-extract",
      "conditions": [
        { "test": "Source PDF is present and readable", "pass": "proceed to Stage 1", "fail": "halt, report missing source" },
        { "test": "Page count matches expected (434 for ASD-STE100 Issue 9)", "pass": "proceed", "fail": "halt, report mismatch" }
      ]
    },
    {
      "id": "GATE-1",
      "name": "Extraction completeness",
      "stage": "post-extract",
      "conditions": [
        { "test": "All 109 extracted files present (w001-p001-p004.md through w109-p433-p434.md)", "pass": "proceed to Stage 2", "fail": "run recovery worker for missing range" },
        { "test": "No truncation markers in any extracted file", "pass": "proceed", "fail": "flag file, re-run worker" },
        { "test": "No fabrication detected (no invented page numbers)", "pass": "proceed", "fail": "halt, audit worker" }
      ]
    },
    {
      "id": "GATE-2",
      "name": "Refinement completeness",
      "stage": "post-refine",
      "conditions": [
        { "test": "All 109 refined files present (r001-p001-p004.md through r109-p433-p434.md)", "pass": "proceed to Stage 3", "fail": "run recovery worker" },
        { "test": "Every refined file references its source extracted file", "pass": "proceed", "fail": "flag and re-run" }
      ]
    },
    {
      "id": "GATE-3",
      "name": "Adaptation completeness",
      "stage": "post-adapt",
      "conditions": [
        { "test": "All 55 adapted rule files present (Sec 1-9, GR1-4)", "pass": "proceed to Stage 5", "fail": "identify missing rules and re-run" },
        { "test": "Every adapted rule has valid frontmatter conforming to rule-frontmatter.schema.json", "pass": "proceed", "fail": "repair frontmatter" }
      ]
    },
    {
      "id": "GATE-4",
      "name": "Artifact integrity",
      "stage": "post-artifact",
      "conditions": [
        { "test": "All 6 artifact files present", "pass": "release ready", "fail": "regenerate missing artifacts" },
        { "test": "System prompt <= 3,000 tokens", "pass": "release ready", "fail": "distill further" },
        { "test": "Self-reading manual covers all 14 principles", "pass": "release ready", "fail": "repair manual" }
      ]
    }
  ]
}

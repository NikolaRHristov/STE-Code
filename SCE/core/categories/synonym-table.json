{
  "version": "2.0.0",
  "source": "ASD-STE100 Issue 9 (January 2025), adapted to code domain",
  "domain": "code",
  "canonical": true,
  "description": "Complete code-domain synonym table — every common unapproved coding term mapped to an approved STE-Code replacement.",
  "pairs": [
    {"approved": "use", "avoid": ["utilize", "leverage", "employ", "harness"], "context": "general"},
    {"approved": "start", "avoid": ["initiate", "commence", "bootstrap", "spin up", "fire up"], "context": "processes, servers, services"},
    {"approved": "stop", "avoid": ["terminate", "halt", "kill", "abort", "shut down", "nuke"], "context": "processes, servers, services"},
    {"approved": "show", "avoid": ["display", "render", "present", "output", "dump", "print"], "context": "UI, CLI, logs"},
    {"approved": "make", "avoid": ["create", "generate", "produce", "fabricate", "instantiate", "spin up"], "context": "objects, files, data structures"},
    {"approved": "get", "avoid": ["retrieve", "fetch", "obtain", "pull", "grab", "acquire"], "context": "data, API responses, files"},
    {"approved": "set", "avoid": ["configure", "assign", "establish", "specify", "define", "declare"], "context": "configuration, variables, options"},
    {"approved": "check", "avoid": ["verify", "validate", "ensure", "confirm", "assert", "audit", "inspect"], "context": "data validity, conditions, state"},
    {"approved": "do", "avoid": ["perform", "execute", "carry out", "run", "invoke", "trigger"], "context": "operations, actions, tasks"},
    {"approved": "send", "avoid": ["transmit", "dispatch", "forward", "push", "post", "submit"], "context": "network, HTTP, messages"},
    {"approved": "remove", "avoid": ["delete", "eliminate", "purge", "erase", "wipe", "destroy", "drop"], "context": "data, files, records, database"},
    {"approved": "keep", "avoid": ["retain", "preserve", "maintain", "store", "persist", "save", "cache"], "context": "data persistence, state"},
    {"approved": "read", "avoid": ["fetch", "retrieve", "obtain", "load", "pull", "import"], "context": "files, database, API GET"},
    {"approved": "write", "avoid": ["set", "configure", "assign", "save", "persist", "commit", "flush"], "context": "files, database, API POST/PUT"},
    {"approved": "build", "avoid": ["make", "create", "generate", "compile", "assemble", "construct"], "context": "binaries, packages, artifacts"},
    {"approved": "test", "avoid": ["check", "verify", "validate", "confirm", "prove", "exercise"], "context": "unit tests, integration, QA"},
    {"approved": "deploy", "avoid": ["release", "ship", "roll out", "push to production", "go live"], "context": "CI/CD, production releases"},
    {"approved": "connect", "avoid": ["attach", "link", "bind", "associate", "join", "wire up"], "context": "network, database, services"},
    {"approved": "copy", "avoid": ["clone", "duplicate", "replicate", "mirror", "fork", "shadow"], "context": "data, repositories, files"},
    {"approved": "move", "avoid": ["transfer", "shift", "migrate", "relocate", "port", "rename"], "context": "data, files, services between environments"},
    {"approved": "find", "avoid": ["search", "locate", "discover", "detect", "scan", "query"], "context": "data lookup, file search"},
    {"approved": "call", "avoid": ["invoke", "execute", "trigger", "fire", "run", "dispatch"], "context": "functions, APIs, endpoints"},
    {"approved": "return", "avoid": ["output", "yield", "produce", "send back", "respond with"], "context": "function returns, API responses"},
    {"approved": "handle", "avoid": ["process", "manage", "deal with", "take care of", "address"], "context": "errors, events, requests"},
    {"approved": "change", "avoid": ["modify", "update", "alter", "mutate", "edit", "revise", "patch"], "context": "code, configuration, data"},
    {"approved": "combine", "avoid": ["merge", "unify", "consolidate", "join", "aggregate", "squash"], "context": "data, branches, files"},
    {"approved": "split", "avoid": ["divide", "separate", "partition", "break apart", "shard", "chunk"], "context": "data, files, services"},
    {"approved": "include", "avoid": ["contain", "hold", "embed", "nest", "wrap", "bundle"], "context": "dependencies, modules, files"},
    {"approved": "cause", "avoid": ["trigger", "induce", "provoke", "result in", "lead to"], "context": "errors, events, side effects"},
    {"approved": "prevent", "avoid": ["block", "stop", "prohibit", "disallow", "forbid", "reject"], "context": "errors, access, data loss"}
  ]
}

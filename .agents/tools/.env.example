# STE-Code Extraction Pipeline — Environment Variables
# Copy this to .env and adjust as needed.

# Model to use for extraction (must match a model in ~/.hermes/config.yaml)
STE_MODEL=poolside/laguna-s-2.1:free

# 109 workers, each extracting 4 pages (434 total pages → 108 workers of 4 + 1 worker of 2)
STE_MAX_WORKERS=109
STE_PAGES_PER_WORKER=4

# 3 workers per batch (sequential within batch due to shared model backend)
STE_WORKERS_PER_BATCH=3

# Total pages in the spec
STE_TOTAL_PAGES=434
